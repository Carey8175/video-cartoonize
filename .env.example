# Copy this file to .env before running docker compose.
# cp .env.example .env

# Backend TOS configuration used by the cartoonize CLI when uploading files.
TOS_ACCESS_KEY=
TOS_SECRET_KEY=
TOS_BUCKET=

# Optional: defaults are already built into the CLI.
TOS_ENDPOINT=tos-ap-southeast-1.bytepluses.com
TOS_REGION=ap-southeast-1
